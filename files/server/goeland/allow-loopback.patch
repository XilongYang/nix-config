 func isSafeIP(ip net.IP) bool {
+	// Loopback is allowed so that goeland can read feeds from the RSSHub
+	// container bound to 127.0.0.1 on the same host. Other private ranges
+	// stay blocked, so a redirect from a remote feed still cannot reach
+	// anything on the LAN.
+	if ip.IsLoopback() {
+		return true
+	}
 	return ip.IsGlobalUnicast() && !ip.IsPrivate()
 }
 
